{# The credit account on the payment step. The amount is sent with the button or Enter ("norender": typing
   changes the model in the browser only, no request per character). Variables: this.balance, this.applied
   (decimal strings), this.currencyId, this.texts, this.error, this.amount. Money goes through format_money. #}
{% set texts = this.texts %}
{% set balance = this.balance %}
{% set applied = this.applied %}
{% set currencyId = this.currencyId %}
{% set error = this.error %}
{% set amount = this.amount %}
<div {{ attributes }} data-loading="addClass(opacity-50 pointer-events-none)" data-testid="checkout-credit">
    <p class="paragraph-3 text-black mt-3">
        {{ texts.available }}
        <strong dir="ltr" data-testid="checkout-credit-balance">{{ format_money(balance, currencyId) }}</strong>
    </p>

    {% if applied|number_format(2) != '0.00' %}
        <p class="paragraph-3 text-black mt-1">
            {{ texts.applied }}
            <strong dir="ltr" data-testid="checkout-credit-applied">{{ format_money(applied, currencyId) }}</strong>
        </p>
    {% endif %}

    {# After a change the field must show the state of the cart, and a re-render leaves a field the buyer
       touched as they left it: under another id the form is a new one, drawn from the server state. #}
    <form
        id="checkout-credit-form-{{ applied|number_format(2, '.', '') }}{{ error ? '-again' : '' }}"
        data-live-id="checkout-credit-form-{{ applied|number_format(2, '.', '') }}{{ error ? '-again' : '' }}"
        class="flex gap-4 items-end mt-3"
        data-action="live#action:prevent"
        data-live-action-param="apply"
        data-testid="checkout-credit-form"
    >
        <div class="flex-1">
            {{ component('Fields:Input:Base', {
                label: texts.amount,
                name: 'checkout-credit-amount',
                id: 'checkout-credit-amount',
                type: 'text',
                value: amount,
                error: error ? true : false,
                'input:inputmode': 'decimal',
                'input:autocomplete': 'off',
                'input:data-model': 'norender|amount',
            }|merge(error ? {'input:aria-describedby': 'checkout-credit-error'} : {})) }}
        </div>
        <twig:Molecules:Button:Base type="submit" text="{{ texts.apply|escape('html') }}" />
        {% if applied|number_format(2) != '0.00' %}
            <twig:Molecules:Button:Base
                color="secondary"
                text="{{ texts.withdraw|escape('html') }}"
                data-action="live#action"
                data-live-action-param="withdraw"
                data-testid="checkout-credit-withdraw"
            />
        {% endif %}
    </form>

    {% if error %}
        <div id="checkout-credit-error" data-testid="checkout-credit-error">
            <twig:Molecules:SnackBar:Base variant="warning" withIcon role="alert" class="mt-3" text="{{ error|escape('html') }}" />
        </div>
    {% endif %}
</div>

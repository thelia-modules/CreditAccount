{# Order edit fragment (hook order-edit.after-order-product-list) — no {% extends %} #}
<div class="card mb-3" id="credit-account-order-usage">
    <div class="card-header">{{ 'Customer credit account usage for this order'|trans({}, 'creditaccount.bo.default') }}</div>
    <div class="card-body">
        <ul class="list-unstyled mb-0">
            {% for entry in entries %}
                <li>
                    {{ 'New entry in customer credit account:'|trans({}, 'creditaccount.bo.default') }}
                    <span class="{{ entry.amount < 0 ? 'text-danger' : 'text-success' }}">{{ entry.amount|number_format(2, '.', ' ') }} {{ currency_symbol }}</span>
                </li>
            {% else %}
                <li>{{ 'No new entry in customer credit account for this order.'|trans({}, 'creditaccount.bo.default') }}</li>
            {% endfor %}
        </ul>
    </div>
</div>
